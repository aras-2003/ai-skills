{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "case", "component", "source_revision", "runtime", "execution", "evaluation"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case": {
      "type": "object",
      "required": ["id", "target", "mode", "input_path", "input_sha256", "rubric_path", "rubric_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "mode": {"enum": ["explicit", "natural-routing"]},
        "input_path": {"type": "string", "minLength": 1},
        "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "rubric_path": {"type": "string", "minLength": 1},
        "rubric_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": ["name", "version", "content_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]},
        "content_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "source_revision": {"type": "string", "minLength": 7},
    "runtime": {
      "type": "object",
      "required": ["provider", "model_id", "reasoning", "catalog"],
      "properties": {
        "provider": {"type": ["string", "null"]},
        "model_id": {"type": ["string", "null"]},
        "reasoning": {"type": ["string", "null"]},
        "catalog": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["assisted", "prompt", "actual_output_path", "actual_output_sha256", "tool_trace_path"],
      "properties": {
        "assisted": {"type": "boolean"},
        "prompt": {"type": ["string", "null"]},
        "actual_output_path": {"type": ["string", "null"]},
        "actual_output_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "tool_trace_path": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "required": ["status", "rubric_version", "reviewer", "timestamp_utc", "note"],
      "properties": {
        "status": {"enum": ["NOT_RUN", "REVIEW_REQUIRED", "PASS", "FAIL"]},
        "rubric_version": {"type": "string", "minLength": 1},
        "reviewer": {"type": ["string", "null"]},
        "timestamp_utc": {"type": "string", "minLength": 1},
        "note": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
