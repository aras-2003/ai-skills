{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_scope",
    "case",
    "component",
    "source_revision",
    "runtime",
    "execution",
    "evaluation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "outcome": {
      "type": ["string", "null"],
      "enum": ["passed", "failed", null]
    },
    "execution_state": {
      "enum": ["executed", "blocked", "awaiting_runner", "no_steps", "not_executed"]
    },
    "execution_state_reason": {
      "type": ["string", "null"]
    },
    "evidence_scope": {
      "enum": [
        "current-version",
        "historical"
      ]
    },
    "case": {
      "type": "object",
      "required": [
        "id",
        "target",
        "mode",
        "input_path",
        "input_sha256",
        "rubric_path",
        "rubric_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "explicit",
            "natural-routing"
          ]
        },
        "input_path": {
          "type": "string",
          "minLength": 1
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rubric_path": {
          "type": "string",
          "minLength": 1
        },
        "rubric_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": [
        "name",
        "version",
        "content_sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "source_revision": {
      "type": "string",
      "minLength": 7
    },
    "runtime": {
      "type": "object",
      "required": [
        "provider",
        "model_id",
        "reasoning",
        "catalog"
      ],
      "properties": {
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasoning": {
          "type": [
            "string",
            "null"
          ]
        },
        "catalog": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "assisted",
        "prompt",
        "actual_output_path",
        "actual_output_sha256",
        "tool_trace_path",
        "selection_findings",
        "evidence_origin"
      ],
      "properties": {
        "assisted": {
          "type": "boolean"
        },
        "prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "actual_output_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "actual_output_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "tool_trace_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_trace_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "selection_findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_origin": {
          "enum": [
            "runtime",
            "offline"
          ]
        }
      },
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "required": [
        "status",
        "rubric_version",
        "reviewer",
        "timestamp_utc",
        "note"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_RUN",
            "REVIEW_REQUIRED",
            "PASS",
            "FAIL"
          ]
        },
        "rubric_version": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp_utc": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "runtime_artifact": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "package_name": {
          "type": "string",
          "minLength": 1
        },
        "package_version": {
          "type": "string",
          "minLength": 1
        },
        "release_id": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "minLength": 7
        },
        "payload_content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "component_content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evaluation": {
            "properties": {"status": {"const": "PASS"}}
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {"const": "passed"},
          "execution_state": {"const": "executed"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "evaluation": {
            "properties": {"status": {"const": "FAIL"}}
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {"const": "failed"},
          "execution_state": {"const": "executed"}
        }
      }
    },
    {
      "if": {
        "required": ["outcome", "execution_state"],
        "properties": {
          "evaluation": {
            "properties": {"status": {"const": "NOT_RUN"}}
          }
        }
      },
      "then": {
        "required": ["outcome", "execution_state", "execution_state_reason"],
        "properties": {
          "outcome": {"const": null},
          "execution_state": {
            "enum": ["blocked", "awaiting_runner", "no_steps", "not_executed"]
          },
          "execution_state_reason": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "evaluation": {
            "properties": {
              "status": {
                "enum": [
                  "REVIEW_REQUIRED",
                  "PASS",
                  "FAIL"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "component": {
            "properties": {
              "version": {
                "type": "string",
                "minLength": 1
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "runtime": {
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "model_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "execution": {
            "properties": {
              "actual_output_path": {
                "type": "string",
                "minLength": 1
              },
              "actual_output_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evaluation": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "assisted": {
                "const": false
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
